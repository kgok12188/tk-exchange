# 复制为 .env 后，仅「启动容器」时必填下面三项；仅构建镜像可不填。
# 启动容器: docker compose up -d  或  ./compose.sh up -d
# 仅构建镜像: docker compose build  或  ./compose.sh build

# ---------- 启动容器时必填 ----------
# 宿主机端口，映射容器 8092
MATCH_ENGINE_HOST_PORT=8092
# 快照目录在宿主机上的绝对路径
MATCH_ENGINE_SNAPSHOT_DIR=/data/match-engine-snapshot
# 文件队列目录在宿主机上的绝对路径
MATCH_ENGINE_QUEUE_DIR=/data/match-engine-queue

# ---------- 可选 ----------
# 镜像 tag，不填则 local
# MATCH_ENGINE_TAG=20250315-143022
# 若 ZK/Kafka 在 exchange 网络上的容器名不是 zookeeper/kafka，可在此覆盖
# KAFKA_SERVERS=kafka:9092
# MATCH_ZOOKEEPER_SERVERS=zookeeper:2181
