<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="com.tk.protocol.sbe.generated"
                   id="1"
                   version="0"
                   semanticVersion="0.1"
                   description="tk-match-engine Aeron SBE protocol"
                   byteOrder="littleEndian">

    <!-- ═══════════════════════ Standard SBE header ═══════════════════════ -->
    <types>
        <composite name="messageHeader" description="SBE message header">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId"  primitiveType="uint16"/>
            <type name="schemaId"    primitiveType="uint16"/>
            <type name="version"     primitiveType="uint16"/>
        </composite>

        <!-- Decimal64: BigDecimal wire representation -->
        <composite name="Decimal64">
            <type name="mantissa" primitiveType="int64"/>
            <type name="exponent" primitiveType="int8"/>
        </composite>

        <!-- Repeating-group header -->
        <composite name="groupSizeEncoding">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup"  primitiveType="uint16"/>
        </composite>

        <!-- Variable-length data header -->
        <composite name="varAsciiEncoding">
            <type name="length"      primitiveType="uint32" maxValue="1073741824"/>
            <type name="varData"     primitiveType="uint8"  length="0" characterEncoding="US-ASCII"/>
        </composite>

        <!-- ═══════════════════ Enumerations ═══════════════════ -->

        <enum name="Side" encodingType="uint8">
            <validValue name="BUY">0</validValue>
            <validValue name="SELL">1</validValue>
        </enum>

        <enum name="PriceType" encodingType="uint8">
            <validValue name="LIMIT">0</validValue>
            <validValue name="MARKET">1</validValue>
            <validValue name="LIMIT_MAKER">2</validValue>
        </enum>

        <enum name="TimeInForce" encodingType="uint8">
            <validValue name="GTC">0</validValue>
            <validValue name="IOC">1</validValue>
            <validValue name="FOK">2</validValue>
        </enum>

        <enum name="FinishStatus" encodingType="uint8">
            <validValue name="COMPLETED">0</validValue>
            <validValue name="CANCEL">1</validValue>
            <validValue name="PART_CANCEL">2</validValue>
            <validValue name="EXCEPTION">3</validValue>
            <validValue name="REJECT">4</validValue>
            <validValue name="POST_ONLY_REJECT">5</validValue>
        </enum>

        <enum name="RejectReason" encodingType="uint8">
            <validValue name="NONE">0</validValue>
            <validValue name="INVALID_ORDER_ID">1</validValue>
            <validValue name="DUPLICATE_ORDER_ID">2</validValue>
            <validValue name="ORDER_EXPIRED">3</validValue>
            <validValue name="INVALID_PRICE_TYPE">4</validValue>
            <validValue name="INVALID_PRICE">5</validValue>
            <validValue name="PRICE_TICK_INVALID">6</validValue>
            <validValue name="INVALID_QUANTITY">7</validValue>
            <validValue name="INVALID_NOTIONAL">8</validValue>
            <validValue name="INVALID_TIME_IN_FORCE">9</validValue>
            <validValue name="POST_ONLY_WOULD_CROSS">10</validValue>
            <validValue name="FOK_NOT_FILLABLE">11</validValue>
            <validValue name="UNKNOWN">12</validValue>
            <validValue name="UNKNOWN_SYMBOL">13</validValue>
            <validValue name="MARKET_CLOSED">14</validValue>
            <validValue name="SYMBOL_ALREADY_EXISTS">15</validValue>
            <validValue name="CONFIG_VERSION_STALE">16</validValue>
        </enum>

        <enum name="BooleanType" encodingType="uint8">
            <validValue name="F">0</validValue>
            <validValue name="T">1</validValue>
        </enum>
    </types>

    <!-- ═══════════════════ Ingress: Commands ═══════════════════ -->

    <!-- templateId=1: PushOrderCommand (trading-server → match-engine) -->
    <sbe:message name="PushOrderCommand" id="1" description="Submit new order">
        <field name="symbolId"    id="1"  type="uint32"/>
        <field name="orderId"     id="2"  type="int64"/>
        <field name="uid"         id="3"  type="int64"/>
        <field name="shardId"     id="4"  type="int32"/>
        <field name="marketId"    id="5"  type="int64"/>
        <field name="side"        id="6"  type="Side"/>
        <field name="priceType"   id="7"  type="PriceType"/>
        <field name="timeInForce" id="8"  type="TimeInForce"/>
        <field name="price"       id="9"  type="Decimal64"/>
        <field name="volume"      id="10" type="Decimal64"/>
        <field name="amount"      id="11" type="Decimal64"/>
        <field name="createTime"  id="12" type="int64"/>
    </sbe:message>

    <!-- templateId=2: CancelOrderCommand -->
    <sbe:message name="CancelOrderCommand" id="2" description="Cancel existing order">
        <field name="symbolId" id="1" type="uint32"/>
        <field name="orderId"  id="2" type="int64"/>
        <field name="uid"      id="3" type="int64"/>
        <field name="shardId"  id="4" type="int32"/>
    </sbe:message>

    <!-- templateId=3: UpdateMarketCommand (admin HTTP → match-engine) -->
    <sbe:message name="UpdateMarketCommand" id="3" description="Update symbol market rules (admin)">
        <field name="symbolId"             id="1"  type="uint32"/>
        <field name="priceScale"           id="2"  type="int32"/>
        <field name="qtyScale"             id="3"  type="int32"/>
        <field name="minQty"               id="4"  type="Decimal64"/>
        <field name="minTradeQuoteAmount"  id="5"  type="Decimal64"/>
        <field name="configVersion"        id="6"  type="int64"/>
        <field name="force"                id="7"  type="BooleanType"/>
        <field name="uuidHigh"             id="8"  type="int64"/>
        <field name="uuidLow"              id="9"  type="int64"/>
    </sbe:message>

    <!-- templateId=4: OpenMarketCommand (admin HTTP → match-engine) -->
    <sbe:message name="OpenMarketCommand" id="4" description="List new symbol (admin)">
        <field name="symbolId"             id="1"  type="uint32"/>
        <field name="priceScale"           id="2"  type="int32"/>
        <field name="qtyScale"             id="3"  type="int32"/>
        <field name="minQty"               id="4"  type="Decimal64"/>
        <field name="minTradeQuoteAmount"  id="5"  type="Decimal64"/>
        <field name="configVersion"        id="6"  type="int64"/>
        <field name="uuidHigh"             id="7"  type="int64"/>
        <field name="uuidLow"              id="8"  type="int64"/>
        <data  name="symbolName"           id="9"  type="varAsciiEncoding"/>
    </sbe:message>

    <!-- templateId=5: CloseMarketCommand (admin HTTP → match-engine) -->
    <sbe:message name="CloseMarketCommand" id="5" description="Delist symbol (admin)">
        <field name="symbolId"      id="1"  type="uint32"/>
        <field name="configVersion" id="2"  type="int64"/>
        <field name="force"         id="3"  type="BooleanType"/>
        <field name="uuidHigh"      id="4"  type="int64"/>
        <field name="uuidLow"       id="5"  type="int64"/>
    </sbe:message>

    <!-- ═══════════════════ Egress: MatchResult ═══════════════════ -->

    <!-- templateId=10: MatchResult (match-engine → consumers via MDC) -->
    <sbe:message name="MatchResult" id="10" description="Result of one matched command; always emitted (1:1)">
        <!-- Header: matchSeq + taker info -->
        <field name="matchSeq"     id="1" type="int64"/>
        <field name="symbolId"     id="2" type="uint32"/>
        <field name="takerUid"     id="3" type="int64"/>
        <field name="takerOrderId" id="4" type="int64"/>
        <field name="takerShardId" id="5" type="int32"/>

        <!-- trades group -->
        <group name="trades" id="6" dimensionType="groupSizeEncoding">
            <field name="index"       id="1"  type="int64"/>
            <field name="price"       id="2"  type="Decimal64"/>
            <field name="volume"      id="3"  type="Decimal64"/>
            <field name="buyUid"      id="4"  type="int64"/>
            <field name="sellUid"     id="5"  type="int64"/>
            <field name="buyOrderId"  id="6"  type="int64"/>
            <field name="sellOrderId" id="7"  type="int64"/>
            <field name="buyShardId"  id="8"  type="int32"/>
            <field name="sellShardId" id="9"  type="int32"/>
            <field name="takerOrderId" id="10" type="int64"/>
            <field name="takerUid"    id="11" type="int64"/>
        </group>

        <!-- finishOrders group -->
        <group name="finishOrders" id="7" dimensionType="groupSizeEncoding">
            <field name="uid"          id="1" type="int64"/>
            <field name="orderId"      id="2" type="int64"/>
            <field name="status"       id="3" type="FinishStatus"/>
            <field name="rejectReason" id="4" type="RejectReason"/>
            <field name="leaveAmount"  id="5" type="Decimal64"/>
            <field name="leaveVolume"  id="6" type="Decimal64"/>
            <field name="shardId"      id="7" type="int32"/>
        </group>
    </sbe:message>

    <!-- ═══════════════════ Snapshot messages ═══════════════════ -->

    <!-- templateId=20: SnapshotHeader -->
    <sbe:message name="SnapshotHeader" id="20" description="Cluster snapshot header">
        <field name="nextMatchSeq" id="1" type="int64"/>
        <field name="symbolCount"  id="2" type="int32"/>
    </sbe:message>

    <!-- templateId=21: SnapshotBookOrder (one per resting order) -->
    <sbe:message name="SnapshotBookOrder" id="21" description="Resting order in snapshot">
        <field name="symbolId"         id="1"  type="uint32"/>
        <field name="orderId"          id="2"  type="int64"/>
        <field name="uid"              id="3"  type="int64"/>
        <field name="shardId"          id="4"  type="int32"/>
        <field name="side"             id="5"  type="Side"/>
        <field name="price"            id="6"  type="Decimal64"/>
        <field name="volume"           id="7"  type="Decimal64"/>
        <field name="remainingVolume"  id="8"  type="Decimal64"/>
        <field name="amount"           id="9"  type="Decimal64"/>
        <field name="remainingAmount"  id="10" type="Decimal64"/>
        <field name="seq"              id="11" type="int64"/>
    </sbe:message>

    <!-- templateId=22: SnapshotSymbolHeader (one per symbol) -->
    <sbe:message name="SnapshotSymbolHeader" id="22" description="Per-symbol metadata in snapshot">
        <field name="symbolId"            id="1" type="uint32"/>
        <field name="orderCount"          id="2" type="int32"/>
        <field name="appliedConfigVersion" id="3" type="int64"/>
        <field name="priceScale"          id="4" type="int32"/>
        <field name="qtyScale"            id="5" type="int32"/>
        <field name="minQty"              id="6" type="Decimal64"/>
        <field name="minTradeQuoteAmount" id="7" type="Decimal64"/>
        <field name="closed"              id="8" type="BooleanType"/>
        <data  name="symbolName"          id="9" type="varAsciiEncoding"/>
    </sbe:message>

</sbe:messageSchema>
